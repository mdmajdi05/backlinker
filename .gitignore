# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/.sidecar-venv/
apps/desktop/.sidecar-build/
apps/desktop/.playwright-browsers/
apps/desktop/.backend-cache/
# The bundled backend is a build artifact (rebuild with `npm run backend`).
apps/desktop/src-tauri/Resources/backend/

# Runtime data (never commit local databases or secrets)
data/
*.db
*.db-wal
*.db-shm
.env
.env.local

# Runtime logs (servers write here while developing)
apps/api/logs/
*.log

# Build artifacts (large binaries stay on disk, the manifest is tracked)
release/macos/*.dmg
release/macos/*.app/
release/macos/autobacklinker-api-*

# OS
.DS_Store
