# ---------------------------------------------------------------------------
# Auto Backlinker - environment configuration
#
# Copy this file to ".env" in the repository root:
#
#   cp .env.example .env
#
# Every variable is prefixed with AUTOBL_ because that is the prefix the
# application settings use (see apps/api/app/core/config.py).  The values
# below are the built-in defaults - the application runs without any .env
# file at all (local SQLite mode).
# ---------------------------------------------------------------------------

# --- identity --------------------------------------------------------------
# Name shown in the UI and in the OpenAPI documentation.
AUTOBL_APP_NAME="Auto Backlinker"
# One of: local | self_hosted | cloud | desktop | test
AUTOBL_ENVIRONMENT="local"
# Verbose logging (JSON lines on stdout).
AUTOBL_DEBUG=false
# Prefix of every REST endpoint.
AUTOBL_API_PREFIX="/api/v1"

# --- security --------------------------------------------------------------
# CHANGE THIS in every deployment that is reachable from the network.
# It signs the JWT access tokens.
AUTOBL_SECRET_KEY="dev-only-insecure-secret-key-change-me-please-000000"
# Encrypts the per-project Google storage_state.  Leave empty: the app creates
# a per-installation key file at <data>/files/login-profile.key (owner only).
# Set it only when a managed deployment needs the key in the environment.
AUTOBL_LOGIN_SECRET=""
# Lifetime of an access token in minutes (default: 12 hours).
AUTOBL_ACCESS_TOKEN_EXPIRE_MINUTES=720
# JSON list of allowed browser origins.
AUTOBL_CORS_ORIGINS=["http://localhost:3000","tauri://localhost"]
# Shared token of the bundled desktop backend (loopback only).  Leave empty
# to disable the local token authentication.
AUTOBL_LOCAL_TOKEN=""
# Allow outbound requests to private / loopback addresses.  Keep this false -
# enabling it removes the SSRF protection of app/core/net.py.
AUTOBL_ALLOW_PRIVATE_NETWORK=false
# Allow file uploads (spreadsheet imports).
AUTOBL_ALLOW_FILE_UPLOADS=true

# --- storage ---------------------------------------------------------------
# One of: auto | local | cloud | hybrid
#   auto   -> "cloud" when AUTOBL_DATABASE_URL points at PostgreSQL, else "local"
#   local  -> always use the local SQLite file
#   cloud  -> always use AUTOBL_DATABASE_URL
#   hybrid -> local SQLite plus synchronisation with the cloud database
AUTOBL_STORAGE_MODE="auto"
# Database URL.  Leave empty to use the local SQLite file in AUTOBL_DATA_DIR.
# Examples:
#   postgresql+psycopg://user:password@localhost:5432/autobacklinker
#   sqlite:////absolute/path/to/autobacklinker.db
AUTOBL_DATABASE_URL=""
# Directory of the application data (database, uploads, backups, logs).
# Defaults to ~/Library/Application Support/AutoBacklinker (macOS),
# %APPDATA%\AutoBacklinker (Windows) or $XDG_DATA_HOME/auto-backlinker (Linux).
# Leave this line commented out - an empty value would use the current
# working directory.
# AUTOBL_DATA_DIR="/absolute/path/to/AutoBacklinker"
# File name of the local SQLite database.
AUTOBL_SQLITE_FILENAME="autobacklinker.db"
# Log every SQL statement.
AUTOBL_DB_ECHO=false
# Connection pool size of the PostgreSQL engine.
AUTOBL_DB_POOL_SIZE=5
# Create the schema automatically at startup (local / desktop mode).
# Set to false and use Alembic (apps/api/scripts/migrate.sh) instead.
AUTOBL_AUTO_CREATE_SCHEMA=true
# Sub directories of AUTOBL_DATA_DIR.
AUTOBL_BACKUP_DIR_NAME="backups"
AUTOBL_MANAGED_FILES_DIR_NAME="files"
AUTOBL_LOGS_DIR_NAME="logs"
# Maximum size of an uploaded spreadsheet in megabytes.
AUTOBL_MAX_UPLOAD_MB=25

# --- queue / workers -------------------------------------------------------
# Run the worker inside the API process (desktop / local mode).
# Set to false when a separate worker container is used.
AUTOBL_WORKER_ENABLED=true
# Seconds between two claim attempts of the worker.
AUTOBL_WORKER_POLL_INTERVAL=1.0
# Number of tasks the worker may run at the same time (global limit).
AUTOBL_WORKER_BATCH_SIZE=5
# Identity of this worker - defaults to "<hostname>:<pid>".
AUTOBL_WORKER_ID=""
# Dispatch the tasks through Celery instead of the embedded worker.
AUTOBL_USE_CELERY=false
AUTOBL_CELERY_BROKER_URL=""
AUTOBL_CELERY_RESULT_BACKEND=""

# --- automation ------------------------------------------------------------
# Timeout of outbound HTTP requests in seconds.
AUTOBL_HTTP_TIMEOUT=25.0
# User agent used for every outbound request.
AUTOBL_USER_AGENT="AutoBacklinker/1.0 (+https://localhost; respectful crawler; contact via app settings)"
# Maximum number of outbound requests per minute.
AUTOBL_MAX_REQUESTS_PER_MINUTE=30
# Honour robots.txt of the target websites.
AUTOBL_RESPECT_ROBOTS=true
# Allow browser automation (Playwright).
AUTOBL_ALLOW_BROWSER_AUTOMATION=true
# Run Playwright without a visible browser window.
AUTOBL_PLAYWRIGHT_HEADLESS=true
# Surface of the manual login window: auto | native | remote.
#   auto   -> a native window on a desktop/local backend, a stream otherwise
#   native -> native window (falls back to streaming without a display)
#   remote -> always stream to the client (used by the web UI)
AUTOBL_LOGIN_VIEW_MODE="auto"
# Resolution and JPEG quality of the live login stream.
AUTOBL_LOGIN_STREAM_WIDTH=1280
AUTOBL_LOGIN_STREAM_HEIGHT=900
AUTOBL_LOGIN_STREAM_QUALITY=60
AUTOBL_LOGIN_STREAM_FPS=10
# Lifetime of a single-use stream ticket in seconds (never the JWT).
AUTOBL_LOGIN_STREAM_TICKET_SECONDS=90
# Hours between two verifications of the same backlink.
AUTOBL_VERIFICATION_INTERVAL_HOURS=168
# Number of links that are verified in one batch.
AUTOBL_VERIFICATION_BATCH_SIZE=25

# --- AI (optional) ---------------------------------------------------------
# Every AI feature degrades to a deterministic implementation when no
# provider is configured.  The result of each AI call carries
# "ai_generated": false in that case.
# One of: openai | openrouter | groq | ollama | lmstudio | anthropic
AUTOBL_AI_PROVIDER=""
# Base URL of the provider.  Leave empty for the default of the provider:
#   openai     -> https://api.openai.com/v1
#   openrouter -> https://openrouter.ai/api/v1
#   groq       -> https://api.groq.com/openai/v1
#   ollama     -> http://localhost:11434/v1
#   lmstudio   -> http://localhost:1234/v1
#   anthropic  -> https://api.anthropic.com
AUTOBL_AI_BASE_URL=""
# API key of the provider.  Locally hosted servers (ollama, lmstudio) do not
# need one.
AUTOBL_AI_API_KEY=""
# Model identifier, for example "gpt-4o-mini" or "claude-sonnet-4-5".
AUTOBL_AI_MODEL=""
# Master switch of the AI layer.
AUTOBL_AI_ENABLED=true

# --- discovery providers (optional) ---------------------------------------
# API keys of the discovery providers.  They can also be passed per run in
# the "config" object of POST /api/v1/discovery/runs.
AUTOBL_BRAVE_SEARCH_API_KEY=""
AUTOBL_SERPAPI_API_KEY=""

# --- local agents / devices ------------------------------------------------
# Heartbeat interval a registered local agent should use.
AUTOBL_DEVICE_HEARTBEAT_SECONDS=30
# Seconds after which a claimed task is returned to the queue when the
# worker dies.
AUTOBL_TASK_LEASE_SECONDS=300

# ---------------------------------------------------------------------------
# Docker Compose only (infrastructure/docker-compose.yml)
# ---------------------------------------------------------------------------
# POSTGRES_USER=autobacklinker
# POSTGRES_PASSWORD=autobacklinker
# POSTGRES_DB=autobacklinker
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
